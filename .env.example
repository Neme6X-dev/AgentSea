# Modèle de configuration du front. Copiez-le en .env (gitignoré).
#   cp .env.example .env && npm run dev
# Seules les variables préfixées VITE_ sont exposées au navigateur : n'y mettez
# jamais de secret, tout ce qui est ici finit dans le bundle public.

# Origine du backend FastAPI.
# En développement, laissez vide : le proxy de vite.config.js transmet /api et
# /sites vers VITE_API_PROXY_TARGET, ce qui évite le préflight CORS.
# En production, renseignez l'origine publique du backend, sans slash final.
VITE_API_BASE_URL=

# Cible du proxy de développement (backend local).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
