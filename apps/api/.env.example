# Configuration de l'API Jarvis.
#
#   cp .env.example .env   puis compléter les valeurs marquées « à renseigner ».
#
# Ce fichier est suivi par git : n'y mettez JAMAIS de secret réel. Les valeurs
# sensibles vont dans `.env`, qui est ignoré.
#
# Au démarrage, `settings.validate()` signale les incohérences. En production, une
# anomalie marquée CRITIQUE **empêche le démarrage** : ces défauts-là ne cassent rien
# tout de suite, ils produisent une plateforme qui semble fonctionner tout en étant
# vulnérable ou en livrant des sites factices.

# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #
APP_ENV=development                      # development | production
APP_HOST=0.0.0.0
APP_PORT=8000

# Origine publique de l'API. C'est elle qui construit les URLs des sites livrés aux
# clients, et l'origine que la balise de mesure appelle. En production : le domaine
# réel, en HTTPS.
PUBLIC_BASE_URL=http://localhost:8000

# Origine du tableau de bord (liens e-mail, redirections OAuth).
APP_BASE_URL=http://localhost:5173

# Origines autorisées pour le front. `*` en développement uniquement.
CORS_ORIGINS=*

DATA_DIR=data
SITES_DIR=sites

LOG_LEVEL=INFO
LOG_JSON=false                           # true en production (agrégateur de logs)

# --------------------------------------------------------------------------- #
# Base de données (PostgreSQL requis)
# --------------------------------------------------------------------------- #
# Valeur produite par `make db-dev`. Port 55432 et non 5432 : une machine de
# développement fait presque toujours tourner un autre PostgreSQL sur le port standard.
DATABASE_URL=postgresql://jarvis:jarvis@127.0.0.1:55432/jarvis
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Les hébergeurs coupent volontiers les connexions inactives derrière leur NAT :
# recycler avant leur seuil évite les erreurs au premier appel du matin.
DB_POOL_RECYCLE_S=1800

# --------------------------------------------------------------------------- #
# Régionalisation
# --------------------------------------------------------------------------- #
# Pays d'un compte qui n'en précise pas. Détermine devise de facturation, taux de TVA,
# indicatif proposé à l'inscription et grille tarifaire appliquée.
DEFAULT_COUNTRY=BJ
DEFAULT_CURRENCY=XOF
DEFAULT_LOCALE=fr
DEFAULT_TIMEZONE=Africa/Porto-Novo
# Pays ouverts à l'inscription, séparés par des virgules. Vide = tous ceux du registre
# (voir app/africa/countries.py).
ENABLED_COUNTRIES=

# --------------------------------------------------------------------------- #
# Modèles (Gemini)
# --------------------------------------------------------------------------- #
# true = réponses simulées, sans réseau. Pratique en développement et en CI ;
# CRITIQUE en production, où les sites générés seraient factices.
GEMINI_MOCK=true
GEMINI_API_KEY=                          # à renseigner
# Clés de secours, séparées par des virgules : essayées dans l'ordre quand la clé
# principale répond 429 (quota épuisé).
GEMINI_API_KEY_FALLBACKS=
GEMINI_CODER_MODEL=gemini-2.5-flash
GEMINI_REVIEWER_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
# Un site complet (html + css + js dans un seul objet JSON) dépasse largement le
# plafond de sortie par défaut : sans ce réglage la réponse est coupée en plein
# milieu et n'apparaît que sous la forme d'un JSON invalide.
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_TIMEOUT_S=180

# Tarif du fournisseur, en FCFA par million de jetons. Sert à valoriser chaque appel
# dans le back-office et à répondre à « combien coûte un site généré ». À ajuster sur
# la facture réelle : le coût est figé à l'écriture, donc un changement ici n'altère
# pas l'historique.
LLM_COST_PER_MTOK_IN_XOF=180
LLM_COST_PER_MTOK_OUT_XOF=1500

# --------------------------------------------------------------------------- #
# Designer n8n (optionnel)
# --------------------------------------------------------------------------- #
# Vide = designer interne seul, aucun appel réseau superflu. Renseigné, n8n est
# interrogé en premier ; toute panne retombe sur le designer interne.
N8N_DESIGNER_URL=
N8N_TIMEOUT_S=45
N8N_CHAT_TIMEOUT_S=600

# --------------------------------------------------------------------------- #
# File de travaux
# --------------------------------------------------------------------------- #
# queue  : les générations partent dans la file, un worker les exécute
#          (`python -m app.jobs.worker`). Seul mode acceptable en production.
# inline : exécution dans le processus web. Pratique en développement, mais une
#          génération y monopolise un worker uvicorn et se perd au redémarrage.
JOB_MODE=queue
JOB_CONCURRENCY=2
JOB_POLL_INTERVAL_S=2
# Au-delà, un travail « en cours » est considéré comme orphelin et remis en file.
# Doit rester nettement supérieur à la plus longue génération.
JOB_LOCK_TIMEOUT_S=900
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=30

# --------------------------------------------------------------------------- #
# Sécurité
# --------------------------------------------------------------------------- #
# Générer avec : openssl rand -hex 32
# Vide ou trop court = aucune authentification ne fonctionne (CRITIQUE).
JWT_SECRET=
JWT_EXPIRE_MINUTES=120

# Clé de service pour les appels n8n vers /api/agents/*.
INTERNAL_API_KEY=

AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MINUTES=15
PUBLIC_RATE_LIMIT_PER_MIN=120

# Comptes promus administrateurs à leur création, séparés par des virgules. Sert à
# amorcer la plateforme : sans lui, personne ne peut ouvrir le back-office sur une
# base neuve. La liste n'est lue qu'à l'inscription.
ADMIN_EMAILS=

# Sel du condensat d'IP des événements. Aucune IP n'est stockée en clair ; le
# condensat sert à distinguer deux visiteurs, jamais à en identifier un.
ANALYTICS_IP_SALT=changez-moi

# --------------------------------------------------------------------------- #
# OAuth (optionnel)
# --------------------------------------------------------------------------- #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --------------------------------------------------------------------------- #
# Encaissement (optionnel — voir app/africa/payments.py)
# --------------------------------------------------------------------------- #
# Agrégateur : kkiapay | fedapay | cinetpay | paydunya | wave | paystack |
#              flutterwave | paymob | stripe
# Le conseillé par pays est le moins cher acceptant le mobile money : un parcours
# exigeant une carte bancaire écarte la majorité des clients dès le premier écran.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# --------------------------------------------------------------------------- #
# Publication sur VPS (optionnel)
# --------------------------------------------------------------------------- #
# Renseignés, les sites partent par SFTP vers ce serveur au lieu d'être servis
# depuis celui-ci. Si l'API tourne déjà sur le VPS cible, laissez vide.
VPS_HOST=
VPS_PORT=22
VPS_USER=
VPS_KEY_PATH=
VPS_BASE_DIR=/var/www/sites
VPS_USE_SUBDOMAIN=false
VPS_DOMAIN=
