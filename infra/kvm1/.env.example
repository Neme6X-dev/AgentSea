# À copier vers /opt/app/.env sur le VPS — le fichier réel n'est jamais versionné.
#
# Ce fichier alimente à la fois Compose (images, limites, DOMAIN) et l'application
# (`env_file` sur les services `app` et `worker`, lu par apps/api/app/config.py).
#
# `settings.validate()` **refuse de démarrer** en production si l'un des points marqués
# CRITIQUE ci-dessous est mal renseigné. C'est délibéré : ces défauts ne cassent rien
# tout de suite, ils produisent une plateforme qui semble fonctionner tout en étant
# vulnérable ou en livrant des sites factices. Un conteneur qui ne passe pas son
# healthcheck laisse le déploiement précédent en place ; une plateforme ouverte à tous
# les vents, non.

# --- Edge / Compose ---
# Domaine réel une fois le DNS en place. `:80` tant qu'il n'y a que l'IP du VPS
# (utiliser alors Caddyfile.http-dev, cf. README.md).
DOMAIN=:80
# `local` construit l'image sur le VPS (aucun registre requis). Passer à `registry`
# seulement quand les identifiants CI_REGISTRY_* sont configurés.
DEPLOY_MODE=local
# Racine du monorepo synchronisée sur le VPS. L'image de l'API se construit depuis
# cette racine — elle a besoin de `packages/templates/catalog`, hors de `apps/api/`.
SRC_DIR=/opt/src/agentsea
CI_REGISTRY=
CI_REGISTRY_IMAGE=jarvis-api
CI_REGISTRY_USER=
CI_REGISTRY_PASSWORD=
APP_TAG=latest
APP_PORT=8080
APP_HOST=0.0.0.0

# Image du front (nginx). En DEPLOY_MODE=local, `deploy.sh` la construit sur le VPS
# depuis apps/web/ sous ce nom. En mode registry, mettre l'image complète du registre.
FRONTEND_IMAGE=jarvis-web
FRONTEND_TAG=latest
FRONTEND_MEM_LIMIT=64m
FRONTEND_CPUS=0.15

# Enveloppe mémoire d'un VPS 4 Go : app 1 Go + worker 1 Go + Postgres 512 Mo +
# front 64 Mo + Caddy 64 Mo ≈ 2,7 Go, le reste pour le système et le cache disque.
APP_MEM_LIMIT=1024m
APP_CPUS=0.50
WORKER_MEM_LIMIT=1024m
WORKER_CPUS=0.50
CADDY_MEM_LIMIT=64m
CADDY_CPUS=0.15
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=0.30

# --- Application ---
# CRITIQUE : `production` active les contrôles stricts de settings.validate().
# Le laisser à `development` sur un serveur public désarme tous les garde-fous suivants.
APP_ENV=production
DATA_DIR=data
SITES_DIR=sites
LOG_LEVEL=INFO
# Journal en JSON, une ligne par événement : indispensable dès qu'un agrégateur les lit.
LOG_JSON=true

# CRITIQUE : URL publique des sites générés. Doit être en HTTPS en production —
# sinon les sites des clients sont servis en clair.
PUBLIC_BASE_URL=https://exemple.tld
# Origine du tableau de bord (liens e-mail, redirections OAuth).
APP_BASE_URL=https://exemple.tld
# CRITIQUE : jamais `*` en production. Liste explicite des origines réelles,
# séparées par des virgules.
CORS_ORIGINS=https://exemple.tld

# --- Postgres (service compose `db`) ---
POSTGRES_USER=jarvis
# Mot de passe fort, uniquement dans le /opt/app/.env réel (jamais commité).
POSTGRES_PASSWORD=
POSTGRES_DB=jarvis
# Doit reprendre les trois valeurs ci-dessus. `db` est le nom du service compose.
DATABASE_URL=postgresql://jarvis:CHANGEME@db:5432/jarvis
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_S=1800

# --- File de travaux ---
# CRITIQUE en pratique : `queue` confie la génération au service `worker`. En `inline`,
# chaque génération monopolise un worker uvicorn 60 à 180 s et est perdue au
# redémarrage. `queue` sans service `worker` en service empile sans jamais dépiler.
JOB_MODE=queue
JOB_CONCURRENCY=2
JOB_POLL_INTERVAL_S=2.0
# Doit rester nettement supérieur à la plus longue génération : en deçà, un travail
# encore en cours serait repris par un second worker et le client recevrait deux sites.
JOB_LOCK_TIMEOUT_S=900
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=30

# --- Régionalisation ---
DEFAULT_COUNTRY=BJ
DEFAULT_CURRENCY=XOF
DEFAULT_LOCALE=fr
DEFAULT_TIMEZONE=Africa/Porto-Novo
# Vide = tous les pays du registre (apps/api/app/africa/countries.py).
ENABLED_COUNTRIES=

# --- Gemini ---
# CRITIQUE : `true` en production livrerait des sites factices à de vrais clients.
GEMINI_MOCK=false
GEMINI_API_KEY=
# Clés de secours, séparées par des virgules : essayées dans l'ordre quand la clé
# principale (et les précédentes de la liste) répond 429 (quota épuisé).
GEMINI_API_KEY_FALLBACKS=
GEMINI_CODER_MODEL=gemini-2.5-flash
GEMINI_REVIEWER_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
# Un site complet (html + css + js en un seul objet JSON) dépasse le plafond de sortie
# par défaut : sans ce réglage la réponse est coupée et arrive en JSON invalide.
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_TIMEOUT_S=180
# Coût du million de jetons en FCFA, pour valoriser les appels dans le back-office.
LLM_COST_PER_MTOK_IN_XOF=180
LLM_COST_PER_MTOK_OUT_XOF=1500

# --- Designer n8n (cadrage conversationnel avant génération) ---
# Vide = designer interne uniquement.
N8N_DESIGNER_URL=
N8N_TIMEOUT_S=45
N8N_CHAT_TIMEOUT_S=600

# --- Authentification / sécurité ---
# CRITIQUE : au moins 32 caractères. Générer avec `openssl rand -hex 32`.
# Le changer invalide tous les jetons déjà émis (tout le monde est déconnecté).
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
# CRITIQUE en production : sans cette clé, les endpoints /api/agents sont ouverts.
# Générer avec `openssl rand -base64 32`, puis la reporter dans les workflows n8n.
INTERNAL_API_KEY=
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MINUTES=15
# Comptes promus administrateurs à leur création, séparés par des virgules.
# À renseigner AVANT la première inscription : sur une base neuve, personne n'a de rôle
# et le back-office reste inaccessible à tous.
ADMIN_EMAILS=
# Sel du condensat d'IP des événements de mesure. Le changer rend les anciens visiteurs
# non rapprochables des nouveaux — c'est voulu, ce n'est pas un identifiant.
# Doit être propre à l'installation : la valeur par défaut du code est publique.
ANALYTICS_IP_SALT=
PUBLIC_RATE_LIMIT_PER_MIN=120

# --- OAuth (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Paiement (cf. app/africa/payments.py) ---
# L'intégration d'un agrégateur reste à faire ; PAYMENT_PROVIDER est le point d'entrée.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# --- Dépôt SFTP des sites vers un autre VPS (optionnel) ---
# Laisser vide : les sites restent servis depuis cette machine par l'edge Caddy.
VPS_HOST=
VPS_PORT=22
VPS_USER=
VPS_KEY_PATH=
VPS_BASE_DIR=/var/www/sites
VPS_USE_SUBDOMAIN=false
VPS_DOMAIN=
